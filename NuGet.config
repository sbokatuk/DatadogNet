<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Locally packed DatadogNet packages. The device tests and the sample reference the packed
      .nupkg rather than the projects, so both run against exactly what gets published - including
      the inter-package dependencies and the platform bindings pulled from nuget.org, which a
      ProjectReference would bypass entirely.
    -->
    <add key="local-artifacts" value="artifacts" />
    <add key="local-android" value="../DatadogNet.Android/artifacts" />
    <add key="local-ios" value="../DatadogNet.iOS/artifacts" />
  </packageSources>
</configuration>
