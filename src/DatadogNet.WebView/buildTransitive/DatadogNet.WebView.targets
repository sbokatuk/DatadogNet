<Project>

  <!--
    Imported into every project that references this package. Only an Android *application* runs
    R8/ProGuard, so that is the only place the rules attach; every other head imports this file
    and does nothing.

    Duplicated from DatadogNet.WebView.Android deliberately: this package's dependency on the
    binding excludes build assets (the NuGet default for packed ProjectReferences), so the
    binding's own buildTransitive rules do not flow through it. An app that references only this
    package still needs WebViewTracking to survive shrinking - it is reached from .NET through
    JNI alone, which R8 cannot see.
  -->
  <ItemGroup Condition=" '$(AndroidApplication)' == 'true' ">
    <ProguardConfiguration Include="$(MSBuildThisFileDirectory)datadog-webview.pro" />
  </ItemGroup>

</Project>
