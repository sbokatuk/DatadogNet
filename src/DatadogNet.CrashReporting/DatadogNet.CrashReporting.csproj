<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Datadog.Facade.props" />

  <PropertyGroup>
    <PackageId>DatadogNet.CrashReporting</PackageId>
    <Title>Datadog crash reporting for .NET MAUI</Title>
    <Description>
      Crash reporting for DatadogNet: KSCrash on iOS and Mac Catalyst (PLCrashReporter in the 2.x
      line), and native (NDK) crash capture on Android. Separate from DatadogNet because it
      installs a signal handler.
    </Description>
    <PackageTags>datadog;maui;crash;crash-reporting;kscrash;ndk;android;ios;maccatalyst</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DatadogNet/DatadogNet.csproj" />
  </ItemGroup>

  <!--
    Android: only the NDK module. JVM-level crash reporting - which is where an unhandled .NET
    exception in a MAUI app ends up - is part of dd-sdk-android-core and is already on, through
    DatadogConfiguration.CrashReportsEnabled. This package adds native crashes on top.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="DatadogNet.Ndk.Android" Version="$(DatadogNetAndroidVersion)" />
  </ItemGroup>

  <!--
    iOS: the whole of crash reporting. dd-sdk-ios has no built-in equivalent of Android's
    setCrashReportsEnabled - DatadogCrashReporting is a framework of its own, carrying
    PLCrashReporter - so on iOS an app without this package reports no crashes at all.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <PackageReference Include="DatadogNet.CrashReporting.iOS" Version="$(DatadogNetiOSVersion)" />
  </ItemGroup>

  <!--
    Mac Catalyst: the same DatadogCrashReporting framework, built for Catalyst. KSCrash supports
    macOS, so native crash capture works there the same way it does on iOS.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <PackageReference Include="DatadogNet.CrashReporting.Mac" Version="$(DatadogNetMacVersion)" />
  </ItemGroup>

  <!--
    Consumer R8/ProGuard keep-rules for the Android head. Packed under buildTransitive/ so NuGet
    imports the .targets into every consuming project; the rules attach only where R8 runs. See
    the files' own comments for why they exist and why they are duplicated from the binding.
  -->
  <ItemGroup>
    <None Include="buildTransitive/DatadogNet.CrashReporting.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="buildTransitive/datadog-ndk.pro" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

</Project>
