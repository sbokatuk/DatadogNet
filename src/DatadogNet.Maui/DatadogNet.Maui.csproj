<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Datadog.Facade.props" />

  <PropertyGroup>
    <!--
      Android, iOS, Mac Catalyst and a Windows stub head, with no platform-neutral asset - which
      is the one place this package differs from DatadogNet, and it is not a choice:
      Microsoft.Maui.Controls is a metapackage with no lib/ assets, its reference assemblies come
      from the installed MAUI workload selected by target platform, and there is no
      platform-neutral flavour of MAUI at any version to compile a no-op against.

      The Windows head is a stub with a purpose. Every call it forwards lands in the core
      package's documented no-op neutral implementation, and its existence removes the last
      platform-conditional PackageReference a multi-headed app needed - UseDatadog compiles and
      runs on the Windows head, and does nothing, exactly like DatadogNet itself there. It is
      compiled from this repository's macOS runners: EnableWindowsTargeting below is the switch
      that permits that, with the WindowsAppSDK reference assemblies arriving from NuGet on
      restore.

      The net8 heads build - MAUI 8.0.100 resolves from nuget.org - but a net8 MAUI *app* does
      not. They ship anyway so that such an app fails with the Android SDK's own error rather
      than a restore error blaming this package. See Directory.Build.props.

      The Mac Catalyst head is first-class, compiling the same Platforms/iOS-shaped integration
      the iOS head uses over the DatadogNet.Mac bindings.
    -->
    <TargetFrameworks>$(DatadogAndroidTargetFramework);$(DatadogiOSTargetFramework);$(DatadogMacTargetFramework);$(DatadogWindowsTargetFramework)</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <PackageId>DatadogNet.Maui</PackageId>
    <Title>Datadog .NET MAUI integration</Title>
    <Description>
      Wires Datadog into a .NET MAUI app: one UseDatadog call on MauiAppBuilder, automatic RUM views
      from page navigation, an ILogger provider, unhandled-exception reporting and HttpClient
      instrumentation.
    </Description>
    <PackageTags>datadog;maui;rum;logging;tracing;ilogger;observability;android;ios;maccatalyst</PackageTags>
  </PropertyGroup>

  <!--
    The Mac Catalyst head cannot ride Datadog.Facade.props's "Catalyst compiles Platforms/iOS"
    arrangement: this is the one UseMaui+SingleProject project, and MAUI's single-project targets
    remove Platforms/iOS/** from every non-iOS head *after* the props' item groups have run. So
    the Catalyst implementation lives in Platforms/MacCatalyst - re-included here because the
    props' blanket Platforms/** removal runs on it too.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <Compile Include="Platforms/MacCatalyst/**/*.cs" />
    <None Remove="Platforms/MacCatalyst/**/*.cs" />
  </ItemGroup>

  <!-- Same re-include for the Windows stub head, for the same reason as MacCatalyst above. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Compile Include="Platforms/Windows/**/*.cs" />
    <None Remove="Platforms/Windows/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DatadogNet/DatadogNet.csproj" />
    <!--
      The Microsoft.Extensions glue - the DI registrations, the ILogger provider,
      AddDatadogTracking - lives there, shared with hosts that have no MAUI. UseDatadog delegates
      to it; what stays here is what only exists in MAUI: page tracking, the lifecycle hooks and
      unhandled-exception reporting.
    -->
    <ProjectReference Include="../DatadogNet.Extensions.DependencyInjection/DatadogNet.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

</Project>
